# Kamino's lending and farms programs (Business Source License 1.1), fetched the same way.
test/programs/kamino_*.so
# JupLend's (Fluid Solana: lending, liquidity, rewards rate model), Business Source License 1.1, fetched the same way.
test/programs/juplend_*.so
# Drift's Merkle distributor (claim_bad_debt), GPL-3.0, fetched the same way.
test/programs/merkle_distributor.so
# Meteora's Dynamic Bonding Curve (Meteora Non-commercial Licence), and the DAMM v2 and locker programs its migration
# calls (their licences not established), fetched the same way.
test/programs/meteora_dbc.so
test/programs/meteora_damm_v2.so
test/programs/meteora_locker.so
